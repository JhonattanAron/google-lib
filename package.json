{
  "name": "@jhonattanaron/google-lib",
  "version": "1.0.0",
  "description": "Reusable Google OAuth integration for Auth.js and Node.js backends",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./authjs": {"types": "./dist/authjs/provider.d.ts", "import": "./dist/authjs/provider.js"},
    "./backend": {"types": "./dist/backend/google-token.d.ts", "import": "./dist/backend/google-token.js"},
    "./frontend": {"types": "./dist/frontend/google-sign-in-button.d.ts", "import": "./dist/frontend/google-sign-in-button.js"}
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {"build": "tsc -p tsconfig.json", "prepare": "npm run build"},
  "peerDependencies": {"next-auth": ">=5.0.0-beta.0", "react": ">=18"},
  "devDependencies": {"@types/node": "^22.0.0", "@types/react": "^19.0.0", "next-auth": "^5.0.0-beta.31", "react": "^19.0.0", "typescript": "^5.7.0"},
  "engines": {"node": ">=20"}
}
