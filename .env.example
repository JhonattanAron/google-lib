# Google OAuth example values only. Copy to your app's local .env file.
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_GOOGLE_ID=replace_with_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_google_oauth_client_secret
GOOGLE_AUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=replace_with_expected_google_audience
